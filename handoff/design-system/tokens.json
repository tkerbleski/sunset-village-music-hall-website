{
  "$description": "Sunset Village Music Hall design tokens. Source of truth is design-system/globals.css; this file mirrors it for tools and non-Tailwind contexts (email, OG images, native).",
  "color": {
    "ink":   { "value": "#18302E", "use": "Primary text, ink bands (header/hero/footer), 2px outlines, primary buttons" },
    "ink-2": { "value": "#4A5856", "use": "Secondary text on fog/paper" },
    "ink-hover": { "value": "#24423F", "use": "Hover for ink buttons; raised surface on ink" },
    "fog":   { "value": "#EEEAE2", "use": "Page background; text on ink" },
    "paper": { "value": "#F8F6F1", "use": "Cards" },
    "sand":  { "value": "#E2DDD3", "use": "Muted/secondary fills, hover fills on fog" },
    "line":  { "value": "#C9C2B4", "use": "Subtle 1px borders in dense/internal UI" },
    "mist":  { "value": "#C9D3CF", "use": "Secondary text on ink" },
    "rule":  { "value": "#3C524F", "use": "Hairlines on ink" },
    "sun":   { "value": "#FF6A3D", "use": "THE call-to-action fill (ink text on it). Accent words in headlines on ink." },
    "sun-hover": { "value": "#FF8259" },
    "yellow": { "value": "#FFC93C", "use": "Ticker bar, highlight panels, eyebrow text on ink, focus ring" },
    "teal":  { "value": "#8FD3CB", "use": "Category/panel fill (community events, leasing band)" },
    "pink":  { "value": "#F6B3BF", "use": "Category/panel fill (workshops)" },
    "sea":   { "value": "#0E5E66", "use": "Links on light grounds; hero photo tint" },
    "map":   { "value": "#DCE7E3", "use": "Map/photo placeholder ground" },
    "destructive": { "value": "#B23A16" }
  },
  "category": {
    "music": "sun", "dj": "yellow", "community": "teal", "workshop": "pink"
  },
  "font": {
    "display": { "family": "Bricolage Grotesque", "weights": [400, 600, 700, 800], "use": "Headings (800) and body (400)" },
    "label":   { "family": "Montserrat", "weights": [600, 700], "use": "Uppercase tracked labels only" },
    "mono":    { "family": "DM Mono", "weights": [400, 500], "use": "Dates, times, prices, meta" }
  },
  "type": {
    "display-xl": { "size": "clamp(3rem, 7.5vw, 6.5rem)", "lineHeight": 0.9, "tracking": "-0.04em", "weight": 800 },
    "display-lg": { "size": "clamp(2.4rem, 5vw, 4rem)", "lineHeight": 0.95, "tracking": "-0.03em", "weight": 800 },
    "heading-xl": { "size": "36px", "lineHeight": 1, "tracking": "-0.02em", "weight": 800 },
    "heading-lg": { "size": "28px", "lineHeight": 1.05, "tracking": "-0.02em", "weight": 800 },
    "heading-md": { "size": "20px", "lineHeight": 1.2, "tracking": "-0.01em", "weight": 800 },
    "lede":       { "size": "19px", "lineHeight": 1.5 },
    "body":       { "size": "17px", "lineHeight": 1.5 },
    "ui":         { "size": "15px", "lineHeight": 1.45 },
    "eyebrow":    { "family": "label", "size": "13px", "tracking": "0.24em", "weight": 700, "case": "upper" },
    "label-sm":   { "family": "label", "size": "11px", "tracking": "0.22em", "weight": 700, "case": "upper" },
    "meta":       { "family": "mono", "size": "13px", "lineHeight": 1.6 },
    "kind":       { "family": "mono", "size": "12px", "tracking": "0.12em", "case": "upper" }
  },
  "space": {
    "base": "4px",
    "gutter": "24px",
    "container": "1280px",
    "section-y": { "default": "72px", "loose": "88px", "tight": "48px" },
    "stack": { "section-head-to-content": "28px", "card-grid-gap": "20px", "row-list-gap": "14px", "inline-gap": "8–12px" }
  },
  "radius": { "xs": "6px", "sm": "10px", "md": "14px", "lg": "18px", "xl": "24px", "2xl": "28px", "3xl": "32px", "4xl": "36px", "full": "9999px" },
  "border": { "outline": "2px solid ink (marketing cards, inputs, chips)", "dashed": "2px dashed ink (placeholder/coming-soon, poster divider)", "subtle": "1px solid line (internal UI)" },
  "elevation": "No drop shadows. Separation comes from 2px ink outlines and color fills. Interactive cards lift 2–3px on hover.",
  "motion": { "press": "120ms, scale(.975)", "hover-lift": "200ms cubic-bezier(0.2, 0, 0.1, 1), translateY(-2px rows / -3px cards)" }
}
