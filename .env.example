# Vercel env vars for the inquiry + newsletter endpoints.
# Until these are set the endpoints return 500 and the forms show an error —
# they never send from placeholder addresses.
RESEND_API_KEY=
INQUIRY_TO=            # destination inbox for booking/event inquiries
INQUIRY_FROM=          # verified Resend sender, e.g. "Sunset Village <hello@...>"
NEWSLETTER_AUDIENCE_ID= # optional Resend Audience for newsletter signups
