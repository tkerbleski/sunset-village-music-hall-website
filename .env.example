# Vercel env vars. Set these in Vercel → Project → Settings → Environment Variables.

# Owner master key for /admin. The first sign-in with it (any email) creates
# the owner's admin account; after that each admin has their own password
# (Team page), and this still works as a recovery password for any admin
# email. Changing it signs everyone out.
ADMIN_PASSWORD=

# Neon Postgres. Set automatically when you add Neon from Vercel → Storage.
# Then run once: DATABASE_URL=… npm run db:setup
DATABASE_URL=

# Vercel Blob (flyer uploads). Set automatically when you add Blob from Vercel → Storage.
BLOB_READ_WRITE_TOKEN=

# Resend, for booking notifications, announcements, and the weekly backup.
# Use a SENDING-ONLY key restricted to the sunsetvillagesf.com domain: this
# site never touches Resend Audiences/Segments, and a restricted key can't.
RESEND_API_KEY=
INQUIRY_TO=            # owner's inbox: booking notifications + weekly backup
INQUIRY_FROM=          # verified sender, e.g. "Sunset Village <hello@sunsetvillagesf.com>"

# Stripe, for selling tickets on the site (Checkout). Secret key from
# Stripe → Developers → API keys (sk_live_…; sk_test_… to try it first).
# Webhook: Stripe → Developers → Webhooks → add endpoint
#   https://sunsetvillagesf.com/api/tickets?action=webhook
#   event: checkout.session.completed
# No webhook signing secret is needed (orders are re-read from Stripe's API).
STRIPE_SECRET_KEY=

# Any long random string. Vercel uses it to authenticate the weekly backup cron.
CRON_SECRET=
